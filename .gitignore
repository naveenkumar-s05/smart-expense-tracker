@'
# Environment variables
.env
.env.*
!.env.example

# Virtual environments
venv/
.venv/
env/

# Python
__pycache__/
*.py[cod]
*$py.class
*.so
.Python

# SQLite databases
*.db
*.sqlite
*.sqlite3
*.db-journal
*.db-wal
*.db-shm

# Backup files
*_backup_*.py
*_backup_*.db

# IDE
.vscode/
.idea/
*.swp
*.swo

# OS
.DS_Store
Thumbs.db
'@ | Set-Content -Path .gitignore -Encoding utf8